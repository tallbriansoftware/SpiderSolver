        <calculation class='tableau' formula='IF [win] =  TRUE&#13;&#10;THEN &quot;win&quot;&#13;&#10;ELSEIF [timedOut] = FALSE&#13;&#10;  THEN &quot;timeout&quot;&#13;&#10;  ELSE &quot;loss&quot;&#13;&#10;&#13;&#10;END' />
